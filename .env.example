HOST=0.0.0.0
PORT=8080

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# API key seeding (optional: omit to skip)
SEED_API_KEY=dev-admin-key
SEED_API_KEY_NAME="Development Admin Key"
SEED_READ_KEY=dev-read-key
SEED_READ_KEY_NAME="Development Portal Key"

RUST_LOG=alexandria_nexus=debug,hexforge=debug,tower_http=debug


# Docker compose environment variables (not used by the app, only for docker-compose)
POSTGRES_USER=alexandria
POSTGRES_PASSWORD=alexandria
POSTGRES_DB=alexandria
DB_PORT=5433
ADMINER_PORT=8088