#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in -h|--help) echo "Usage: tools/import-bibitems <file.csv> [--delete-stale]" >&2; exit 0;; esac

if [ $# -lt 1 ]; then
    echo "Usage: tools/import-bibitems <file.csv> [--delete-stale]" >&2
    exit 1
fi

FILE="$1"
DELETE_STALE=""
if [ "${2:-}" = "--delete-stale" ]; then
    DELETE_STALE="?delete_stale=true"
fi

source .env 2>/dev/null || true
BASE="http://${HOST:-localhost}:${PORT:-8080}"
KEY="${SEED_API_KEY:?Set SEED_API_KEY in .env}"

curl -s -w "\nHTTP %{http_code}\n" -X POST "$BASE/api/v1/admin/import-full-csv$DELETE_STALE" \
    -H "Authorization: Bearer $KEY" \
    -F "file=@$FILE"
