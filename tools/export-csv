#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in -h|--help) echo "Usage: tools/export-csv" >&2; exit 0;; esac

source .env 2>/dev/null || true
BASE="http://${HOST:-localhost}:${PORT:-8080}"
KEY="${SEED_API_KEY:?Set SEED_API_KEY in .env}"

curl -s -w "\nHTTP %{http_code}\n" -X POST "$BASE/api/v1/admin/export-full-csv" \
    -H "Authorization: Bearer $KEY"
